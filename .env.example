# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"

# DDoS Shield AI Engine Configuration
DEFENSE_MODE="DRY_RUN" # Options: DRY_RUN, ENFORCING, LOCKDOWN
DEFAULT_RPS_THRESHOLD=100
DEFAULT_BURST_CAPACITY=150
CIRCUIT_BREAKER_CPU_THRESHOLD=85
CIRCUIT_BREAKER_RAM_THRESHOLD=90

# Protected administrative IP subnets (never blocked by auto-mitigation)
ADMIN_SAFE_IPS="127.0.0.1,::1,10.0.0.0/8,192.168.1.0/24"

# IP Reputation and Geolocation Provider (optional external API)
IP_REPUTATION_ENABLED=true
IP_PRIVACY_MASKING=false

